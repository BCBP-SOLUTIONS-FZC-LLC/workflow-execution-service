# Application
APP_ENV=dev                          # local | dev | test | staging | prod
BUILD_VERSION=local

# Server (cmd/server: HTTP + outbox relay)
HTTP_PORT=8080
# METRICS_PORT serves /metrics for the API process; WORKER_METRICS_PORT does the same for the worker.
METRICS_PORT=9091
WORKER_METRICS_PORT=8082

# Worker (cmd/worker: Temporal worker, minimal health/metrics surface)
WORKER_HEALTH_PORT=8081

# platform-gincommon — OTel tracing
OTEL_SERVICE_NAME=workflow-execution-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

# PostgreSQL (pgx DSN)
# Host ports below (5433/6380/4567/6433) are deliberately offset from
# definition_service's docker-compose.yml (5432/6379/4566/6432) so both
# services' local stacks can run at the same time — needed for any local
# cross-service testing (the compiled-plan read, the archive guard, the pause calls).
#
# Direct to Postgres (default — local dev without PgBouncer):
DATABASE_URL=postgres://wfexec:wfexec@localhost:5433/workflow_execution?sslmode=disable
# Via PgBouncer (also set PG_BOUNCER_MODE=true and PG_MIN_CONNS=0):
# DATABASE_URL=postgres://wfexec:wfexec@localhost:6433/workflow_execution?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_SLOW_QUERY_THRESHOLD_MS=200
# true when DATABASE_URL points to PgBouncer: switches pgx to simple protocol +
# transaction-local GUC injection. Migrations must still use a direct Postgres URL.
PG_BOUNCER_MODE=false
# Temporal sticky workflow cache entries per worker process. 0 keeps the SDK default (10000).
WORKFLOW_CACHE_SIZE=0
# MIGRATION_DATABASE_URL: direct Postgres DSN for the migrate subcommand.
# Required when DATABASE_URL points to PgBouncer (golang-migrate uses session advisory locks).
# Unset = uses DATABASE_URL (for local dev pointing directly at Postgres).
# MIGRATION_DATABASE_URL=postgres://wfexec:wfexec@localhost:5433/workflow_execution?sslmode=disable
# LOCK_DATABASE_URL: direct Postgres DSN for the advisory lock that serializes tenant and user
# event handling. A session lock taken through a transaction-pooling proxy can stay held on a
# server connection, so it is required outside dev when PG_BOUNCER_MODE=true. Unset = DATABASE_URL.
# LOCK_DATABASE_URL=postgres://wfexec:wfexec@localhost:5433/workflow_execution?sslmode=disable

# Valkey / Redis
VALKEY_ADDR=localhost:6380
VALKEY_PASSWORD=
VALKEY_DIAL_TIMEOUT=2s
VALKEY_READ_TIMEOUT=1s
VALKEY_WRITE_TIMEOUT=1s

# Temporal — the only service in the platform that talks to the shared cluster.
# Local dev server started by `make docker-up` (temporalio/server, start-dev mode).
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=wf-queue-default

# AWS — SNS (outbox relay)
# AWS_USE_STUB=true  → in-process no-op stubs; AWS vars ignored (dev and local only; refused elsewhere)
# AWS_USE_STUB=false → real SNS client; set remaining vars below
#
# For LocalStack end-to-end testing (make docker-up, then flip AWS_USE_STUB=false):
#   AWS_ENDPOINT_URL=http://localhost:4567
#   SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wf-workflow-events
AWS_USE_STUB=true
AWS_REGION=us-east-1
# Glue schema registry the SNS codec encodes against; required when AWS_USE_STUB=false.
# GLUE_REGISTRY_NAME=wf-workflow-events
# Dummy static credentials — required by awsconfig.LoadDefaultConfig in integration tests
# so the SDK resolves immediately instead of falling back to EC2 IMDS (which times out).
# make test-integration sets these automatically; add to your shell if running go test directly.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_EC2_METADATA_DISABLED=true
AWS_ENDPOINT_URL=http://localhost:4567
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wf-workflow-events

# AWS Glue Schema Registry (LLD §6.8) — also read by cmd/server to build the
# event-envelope glue.Codec. Required when AWS_USE_STUB=false.
GLUE_REGISTRY_NAME=wf-workflow-events
GLUE_SCHEMA_CACHE_TTL=5m

# Outbox relay worker (cmd/server only)
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# The API server samples rls_violation_log and the DEGRADED and READY-task gauges through the relay role.
RLS_VIOLATION_EXPORT_INTERVAL=30s
RLS_VIOLATION_RETENTION=168h
OUTBOX_RETENTION=61320h
# Tenant data purge (LLD §4.13): an offboarded tenant keeps its instances, tasks and
# connector rows for this long, then the sweep deletes them. The audit trail
# (outbox) keeps OUTBOX_RETENTION. Set TENANT_PURGE_ENABLED=false to keep everything.
# Statuses (comma-separated) for which POST /instances answers 409 TENANT_NOT_ACTIVE: trial,
# active, past_due, cancelled, suspended, trial_expired, offboarded. An offboarded tenant is
# always refused; empty refuses nothing else.
START_REFUSED_STATUSES=
TENANT_PURGE_ENABLED=true
TENANT_HISTORY_RETENTION=61320h
PROCESSED_EVENT_RETENTION=168h
RETENTION_SWEEP_INTERVAL=24h
RETENTION_SWEEP_BATCH=1000
OPERATIONAL_STATS_INTERVAL=30s

# OUTBOX_RELAY_DATABASE_URL: DSN for the BYPASSRLS execution_outbox_relay role
# (the relay scans every tenant's unpublished rows in one query). Required when
# APP_ENV is outside dev and local — falling back to DATABASE_URL against a real RLS-enforced role
# would silently see zero rows forever instead of failing fast.
# OUTBOX_RELAY_DATABASE_URL=postgres://execution_outbox_relay:wfexec@localhost:5433/workflow_execution?sslmode=disable

# Outbound service dependencies
# The Definition Service internal API (LLD §5.3), read by cmd/server, cmd/worker
# and cmd/connector-worker (compiled plans, the connector alias registry), and its
# INTERNAL_API_TOKEN, required outside dev.
DEFINITION_SERVICE_URL=http://localhost:8080
DEFINITION_SERVICE_TOKEN=
ELIGIBILITY_BASE_URL=http://localhost:8082
# The identity subsystem's Token Service, read for each tenant's automation principal
# (a connector step is recorded under it). Required outside dev; unset in dev, a
# connector step is refused for want of a principal.
# TOKEN_SERVICE_BASE_URL=http://localhost:8084
ELIGIBILITY_CLIENT_TIMEOUT=5s

# Internal-service auth (cmd/server's /internal routes; empty disables the check — dev only)
INTERNAL_API_TOKEN=

# cmd/worker — dynamic task-queue topology poll interval
QUEUE_TOPOLOGY_POLL_INTERVAL=60s

# cmd/connector-worker — Valkey Stream (also read by cmd/server, which
# publishes onto it via internal_events.go's workflow.task.created handler)
CONNECTOR_STREAM_KEY=connector-tasks
CONNECTOR_STREAM_GROUP=connector-worker
# CONNECTOR_STREAM_CONSUMER_NAME: empty falls back to os.Hostname()
CONNECTOR_STREAM_CONSUMER_NAME=
CONNECTOR_STREAM_BLOCK_TIMEOUT=5s
CONNECTOR_STREAM_CLAIM_MIN_IDLE=30s
CONNECTOR_STREAM_BATCH_SIZE=10
# An entry delivered more often than this moves to the dead-letter stream
CONNECTOR_STREAM_MAX_DELIVERIES=10
CONNECTOR_STREAM_DEAD_LETTER_KEY=connector-tasks-dead

# cmd/connector-worker — OpenBao KV-v2 read side (required for this binary only)
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=
OPENBAO_MOUNT=secret
OPENBAO_TIMEOUT=5s

# cmd/connector-worker — definition_service owns the endpointAlias/queryAlias
# registry; fetched from DEFINITION_SERVICE_URL's GET /api/v1/internal/connector-aliases
CONNECTOR_ALIAS_FETCH_TIMEOUT=10s
# Re-fetch the alias registry on this interval so an alias added or corrected
# after a worker started reaches it without a restart. 0 disables refreshing.
CONNECTOR_ALIAS_REFRESH_INTERVAL=5m

# cmd/connector-worker — per-connector-type dispatch pool size + internal
# execution timeout (covers total time including retries/backoff)
CONNECTOR_POOL_SIZE_STORAGE=10
CONNECTOR_POOL_SIZE_SEND_EMAIL=5
CONNECTOR_POOL_SIZE_DOCUMENT_EXTRACT=10
CONNECTOR_POOL_SIZE_REST_CALL=20
CONNECTOR_POOL_SIZE_SQL_QUERY=15
CONNECTOR_POOL_SIZE_CHAT_NOTIFY=5
CONNECTOR_TIMEOUT_STORAGE=60s
CONNECTOR_TIMEOUT_SEND_EMAIL=10s
CONNECTOR_TIMEOUT_DOCUMENT_EXTRACT=60s
CONNECTOR_TIMEOUT_REST_CALL=30s
CONNECTOR_TIMEOUT_SQL_QUERY=15s
CONNECTOR_TIMEOUT_CHAT_NOTIFY=10s

# cmd/connector-worker — calls execution_service's own
# POST /internal/connector-tasks/:id/{complete,fail} (required); reuses
# INTERNAL_API_TOKEN above as the shared secret those endpoints already check
EXECUTION_SERVICE_INTERNAL_ADDR=http://localhost:8080
CONNECTOR_COMPLETION_TIMEOUT=5s

# The attempt limit and backoff bounds of a retry the connector library allows, and how long
# Drive upload audit rows are kept before the daily prune.
CONNECTOR_RETRY_MAX_ATTEMPTS=5
CONNECTOR_RETRY_INITIAL_BACKOFF=500ms
CONNECTOR_RETRY_MAX_BACKOFF=10s
CONNECTOR_AUDIT_RETENTION=2160h

# Bounds on a call to the Definition Service and to the Token Service, and how long the
# idempotency-key response cache keeps a 2xx answer.
DEFINITION_CLIENT_TIMEOUT=5s
TOKEN_SERVICE_CLIENT_TIMEOUT=5s
IDEMPOTENCY_TTL=24h
