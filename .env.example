# Application
APP_ENV=dev                          # dev | prod
BUILD_VERSION=local

# Server (cmd/server: HTTP + gRPC + outbox relay)
HTTP_PORT=8080
GRPC_PORT=9090

# Worker (cmd/worker: Temporal worker, minimal health/metrics surface)
WORKER_HEALTH_PORT=8081

# platform-gincommon — OTel tracing
OTEL_SERVICE_NAME=execution-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

# PostgreSQL (pgx DSN)
# Host ports below (5433/6380/4567/6433) are deliberately offset from
# definition_service's docker-compose.yml (5432/6379/4566/6432) so both
# services' local stacks can run at the same time — needed for any local
# cross-service testing (GetCompiledWorkflow / CheckActiveInstances / PauseUserTasks).
#
# Direct to Postgres (default — local dev without PgBouncer):
DATABASE_URL=postgres://wfexec:wfexec@localhost:5433/workflow_execution?sslmode=disable
# Via PgBouncer (also set PG_BOUNCER_MODE=true and PG_MIN_CONNS=0):
# DATABASE_URL=postgres://wfexec:wfexec@localhost:6433/workflow_execution?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_SLOW_QUERY_THRESHOLD_MS=200
# true when DATABASE_URL points to PgBouncer: switches pgx to simple protocol +
# transaction-local GUC injection. Migrations must still use a direct Postgres URL.
PG_BOUNCER_MODE=false
# MIGRATION_DATABASE_URL: direct Postgres DSN for the migrate subcommand.
# Required when DATABASE_URL points to PgBouncer (golang-migrate uses session advisory locks).
# Unset = uses DATABASE_URL (for local dev pointing directly at Postgres).
# MIGRATION_DATABASE_URL=postgres://wfexec:wfexec@localhost:5433/workflow_execution?sslmode=disable

# Valkey / Redis
VALKEY_ADDR=localhost:6380
VALKEY_PASSWORD=
VALKEY_DIAL_TIMEOUT=2s
VALKEY_READ_TIMEOUT=1s

# Temporal — the only service in the platform that talks to the shared cluster.
# Local dev server started by `make docker-up` (temporalio/server, start-dev mode).
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=execution-default

# AWS — SNS (outbox relay)
# AWS_USE_STUB=true  → in-process no-op stubs; AWS vars ignored (default for unit dev work)
# AWS_USE_STUB=false → real SNS client; set remaining vars below
#
# For LocalStack end-to-end testing (make docker-up, then flip AWS_USE_STUB=false):
#   AWS_ENDPOINT_URL=http://localhost:4567
#   SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wf-workflow-events
AWS_USE_STUB=true
AWS_REGION=us-east-1
# Dummy static credentials — required by awsconfig.LoadDefaultConfig in integration tests
# so the SDK resolves immediately instead of falling back to EC2 IMDS (which times out).
# make test-integration sets these automatically; add to your shell if running go test directly.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_EC2_METADATA_DISABLED=true
AWS_ENDPOINT_URL=http://localhost:4567
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wf-workflow-events

# AWS Glue Schema Registry — local `make schema-register`/`schema-prune` runs only
# (LLD §6.8). Not read by cmd/server or cmd/worker.
GLUE_REGISTRY_NAME=wf-workflow-events

# Outbox relay worker
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# Outbound service dependencies
# execution_service calls DefinitionService.GetCompiledWorkflow over gRPC (LLD §5.3).
DEFINITION_SERVICE_ADDR=localhost:9090
