<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  id="Def_CompatPartner" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_CompatPartner" name="Compat Partner Call" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ops" name="Ops"><bpmn:extensionElements><zeebe:properties><zeebe:property name="dept_id" value="{{DEPARTMENT}}"/></zeebe:properties></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Partner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1"/>
    <bpmn:serviceTask id="Call_Partner" name="Call Partner">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="connector:rest-call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=partnerAlias" target="endpointAlias"/>
          <zeebe:input source="=order" target="body"/>
          <zeebe:output source="=status" target="partnerStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Review"><bpmn:extensionElements><zeebe:taskDefinition type="approve"/><zeebe:assignmentDefinition candidateGroups="ops" candidateUsers="{{ASSIGNEE}}"/></bpmn:extensionElements></bpmn:userTask>
    <bpmn:endEvent id="End_1"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Call_Partner"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Call_Partner" targetRef="Review"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Review" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_CompatPartner">
      <bpmndi:BPMNShape id="Lane_ops_di" bpmnElement="Lane_ops"/>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"/>
      <bpmndi:BPMNShape id="Call_Partner_di" bpmnElement="Call_Partner"/>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review"/>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"/>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"/>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"/>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"/>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
