{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowInstanceTerminatedPayload",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_instance_id", "subject_id", "business_key", "workflow_version_id", "started_by_user_id", "initiator", "recipients"],
  "properties": {
    "recipients": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string", "enum": ["user", "department"] }, "id": { "type": "string", "format": "uuid" } } } },
    "workflow_instance_id": { "type": "string", "format": "uuid" },
    "subject_id": { "type": "string" },
    "business_key": { "type": "string" },
    "workflow_version_id": { "type": "string", "format": "uuid" },
    "started_by_user_id": { "type": "string", "format": "uuid" },
    "initiator": { "type": "string", "enum": ["admin", "tenant_state"] },
    "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
    "reason": { "type": ["string", "null"] }
  }
}
