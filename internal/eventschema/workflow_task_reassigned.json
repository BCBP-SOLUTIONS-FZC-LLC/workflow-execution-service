{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowTaskReassignedPayload",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_instance_id", "business_key", "workflow_version_id", "task_id", "node_key", "department_id", "assignee_user_ids", "old_user_id", "new_user_id", "initiator"],
  "properties": {
    "workflow_instance_id": { "type": "string", "format": "uuid" },
    "business_key": { "type": "string" },
    "workflow_version_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "node_key": { "type": "string" },
    "department_id": { "type": "string", "format": "uuid" },
    "assignee_user_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "old_user_id": { "type": "string", "format": "uuid" },
    "new_user_id": { "type": "string", "format": "uuid" },
    "initiator": { "type": "string", "enum": ["admin", "override", "delegation"] },
    "delegation_id": { "type": ["string", "null"], "format": "uuid" }
