{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserAvailabilityChangedInbound",
  "type": "object",
  "required": [
    "user_id",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "ooo",
        "busy"
      ]
    },
    "ooo_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ooo_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "delegate_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
